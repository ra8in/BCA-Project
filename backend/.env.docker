# ─────────────────────────────────────────────
# Backend Environment (Docker)
# Copy this to .env.docker and fill in values
# ─────────────────────────────────────────────

DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production

# Database (overridden by docker-compose environment)
DATABASE_URL=postgres://postgres:postgres@db:5432/paper_trading_db

# Redis (overridden by docker-compose environment)
REDIS_URL=redis://redis:6379/0
